# ==========================================================================
# 本地密钥配置模板 —— 团队每个人都要做这一步
# ==========================================================================
# 用法：把本文件复制一份，重命名为 application-local.yml，填入你自己的真实值。
#   application-local.yml 已被 .gitignore 忽略，不会提交到 git，请勿把真实密钥提交。
#
# 运行时 Spring Boot 会自动加载【启动后端的那个目录】下的 application-local.yml，
# 覆盖 application.yml 里的占位符（${DB_PASSWORD:}、${JWT_SECRET:}、${TURNSTILE_SECRET_KEY:}、${ALIPAY_*:}）。
# 所以这个文件要放在 backend/ 根目录（和你运行 mvn / IDEA 启动的那层一致）。
# ==========================================================================

spring:
  datasource:
    # 你本地 MySQL 的密码（每人本机可能不一样，填你自己的；用户名默认 root）
    password: 改成你本地的MySQL密码

# JWT 密钥：团队可共用下面这一串；本地调试随便填一串也行（仅本机 token 校验用）
jwt:
  secret: agri-platform-secret-key-2026-jwt-token-validation

# Cloudflare Turnstile 人机验证
# - Site Key（公有）已写在前端 frontend/.env，随代码提交，无需在此配。
# - Secret Key（私有）由项目负责人统一发放，找负责人要，填在下面；勿提交、勿外传。
turnstile:
  enabled: true
  secret-key: 找负责人拿Secret-Key填这里

# 支付宝沙箱支付（电脑网站支付 alipay.trade.page.pay，公钥模式）
# - AppID / 应用私钥 / 支付宝公钥：登录支付宝开放平台「沙箱」页面获取；公钥模式无需证书文件。
# - 三项由项目负责人统一发放（团队共用同一个沙箱应用），填在下面；勿提交、勿外传。
# - 网关 gateway / 回调 return-url 等已在 application.yml 配好默认值，本地无需再配。
alipay:
  app-id: 找负责人拿沙箱AppID填这里
  app-private-key: 找负责人拿应用私钥填这里
  alipay-public-key: 找负责人拿支付宝公钥填这里
